{
  "name": "@stackline/client-errors",
  "version": "1.0.1",
  "description": "A lightweight frontend error reporting SDK for browser applications, with normalized payloads, sanitization, and transport to any developer-defined endpoint.",
  "license": "MIT",
  "author": "Alexandro Paixao Marques",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alexandroit/client-errors.git"
  },
  "bugs": {
    "url": "https://github.com/alexandroit/client-errors/issues"
  },
  "homepage": "https://alexandro.net/docs/vanilla/client-errors/",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "CHANGELOG.md",
    "SECURITY.md",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "postbuild": "node scripts/normalize-declarations.mjs",
    "build:docs": "node scripts/build-docs.mjs",
    "build:download": "node scripts/build-download.mjs",
    "build:all": "npm run build && npm run build:docs && npm run build:download",
    "dev:docs": "node scripts/dev-server.mjs",
    "clean": "rm -rf dist",
    "typecheck": "node node_modules/typescript/bin/tsc --noEmit",
    "typecheck:legacy": "node node_modules/typescript-3-9/bin/tsc -p scripts/tsconfig.typescript-3.9.json",
    "test": "node --import tsx --test tests/*.test.ts",
    "check": "npm run typecheck && npm test && npm run build && npm run typecheck:legacy && npm run build:docs && npm run build:download"
  },
  "keywords": [
    "stackline",
    "client-errors",
    "browser-errors",
    "frontend-errors",
    "error-reporting",
    "error-sdk",
    "browser-sdk",
    "runtime-errors",
    "unhandledrejection",
    "window-error",
    "frontend-monitoring",
    "error-capture",
    "payload-normalization",
    "sanitization",
    "breadcrumbs",
    "screenshot",
    "http-post",
    "fetch",
    "typescript",
    "vanilla-js",
    "framework-agnostic",
    "privacy-aware",
    "production-ready",
    "browser"
  ],
  "devDependencies": {
    "@types/node": "^22.20.1",
    "esbuild": "^0.28.2",
    "tsup": "^8.5.0",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "typescript-3-9": "npm:typescript@3.9.10"
  },
  "overrides": {
    "tsup": {
      "esbuild": "^0.28.2"
    }
  }
}
